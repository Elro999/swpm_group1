# Copy to .env.local and fill in. NEVER commit .env.local or paste keys into chat.
# With nothing set, the app runs in mock AI mode with an in-memory store (no accounts needed).

# --- Modes ---
# mock | live   (live needs the AI keys below)
AI_MODE=mock
# memory | supabase   (supabase needs the two Supabase values below; memory is refused on Vercel)
DATA_MODE=memory
# openai | deepgram   (speech-to-text provider used in live mode)
STT_PROVIDER=openai

# --- Supabase (setup step S1 in product/03_build-plan.md) ---
# Project Settings → API. The service-role key is server-only; never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers (setup step S3) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
# Optional overrides
LLM_MODEL_JUDGE=claude-sonnet-5-5
LLM_MODEL_FAST=claude-haiku-5-5

# --- Admin (setup step S4) ---
# Any random string of 16+ characters; unlocks /admin (review queue and metrics).
ADMIN_KEY=
