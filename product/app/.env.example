# Copy to .env.local and fill in. NEVER commit .env.local or paste keys into chat.
# With nothing set, the app runs in mock AI mode with an in-memory store (no accounts needed).

# --- Modes ---
# mock | live   (live needs the AI keys below)
AI_MODE=mock
# memory | supabase   (supabase needs the two Supabase values below; memory is refused on Vercel)
DATA_MODE=memory
# openai | deepgram   (speech-to-text provider used in live mode)
STT_PROVIDER=openai

# --- Supabase (setup step S1 in product/03_build-plan.md) ---
# Project Settings → API. The service-role key is server-only; never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers (setup step S3) ---
# Live mode uses OpenAI for both the model and speech-to-text (whisper-1), so one key is enough.
# openai (implemented) | anthropic (not implemented yet)
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Optional model overrides (defaults: gpt-6.1-sol for judging, gpt-6-luna for quick extraction)
LLM_MODEL_JUDGE=
LLM_MODEL_FAST=
# Unused unless you switch providers
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=

# --- Admin (setup step S4) ---
# Any random string of 16+ characters; unlocks /admin (review queue and metrics).
ADMIN_KEY=

# --- Cost, abuse and retention controls (review fixes, 2026-11-14) ---
# Deployment-wide cap on AI calls per 24 h across all users (default 1500). Also set a spend limit in your OpenAI account.
AI_GLOBAL_DAILY_LIMIT=
# New anonymous sessions allowed per network (hashed IP) per hour (default 60, enough for a class on one campus network).
SESSION_STARTS_PER_HOUR=
# Random string; Vercel Cron sends it to /api/cron/retention, which deletes audio older than 30 days. Unset = retention off.
CRON_SECRET=
